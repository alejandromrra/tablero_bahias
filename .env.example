# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# (Project Settings → API). Solo la URL y la clave pública "anon" van al navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# NUNCA pongas la service_role key en variables VITE_* ni en el repo:
# Vite la embebería en el bundle del navegador. La app no la necesita.
